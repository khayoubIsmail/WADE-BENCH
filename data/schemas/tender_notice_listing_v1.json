{
  "schema_id": "tender_notice_listing_v1",
  "domain": "government/tenders",
  "version": "1.0",
  "description": "Schema for extracting government tender/procurement notices from listing/search results pages. Each record is one notice card.",

  "required_fields": ["tender_title", "tender_url"],

  "optional_fields": {
    "notice_id":          {"type": "string", "description": "Notice identifier/reference number.", "sites": ["publiccontractsscotland", "sam", "sell2wales", "ted", "ungm"]},
    "notice_type":        {"type": "string", "description": "Type of notice (e.g. 'Contract Notice', 'Award Notice').", "sites": ["fat", "publiccontractsscotland", "sam", "sell2wales", "ted", "ungm", "worldbank"]},
    "ocid":               {"type": "string", "description": "Open Contracting ID.", "sites": ["publiccontractsscotland", "sell2wales"]},
    "reference_no":       {"type": "string", "description": "Reference number.", "sites": ["publiccontractsscotland"]},
    "tender_reference":   {"type": "string", "description": "Tender reference number (FAT).", "sites": ["fat"]},
    "reference_number":   {"type": "string", "description": "Notice/opportunity reference number (SAM).", "sites": ["sam"]},
    "rfx_id":             {"type": "string", "description": "RFx ID (GETS NZ).", "sites": ["gets"]},
    "reference":          {"type": "string", "description": "Reference string (GETS, UNGM).", "sites": ["gets", "ungm"]},
    "buyer":              {"type": "string", "description": "Buying organization (Contracts Finder).", "sites": ["cfin"]},
    "buyer_name":         {"type": "string", "description": "Buyer organization name.", "sites": ["publiccontractsscotland", "sam", "sell2wales", "ted", "ungm"]},
    "organisation":       {"type": "string", "description": "Contracting organization (GETS).", "sites": ["gets"]},
    "published_by":       {"type": "string", "description": "Published by (Public Contracts Scotland).", "sites": ["publiccontractsscotland"]},
    "agency":             {"type": "string", "description": "Procuring agency (FAT).", "sites": ["fat"]},
    "department_ind_agency": {"type": "string", "description": "Department/independent agency (SAM).", "sites": ["sam"]},
    "subtier":            {"type": "string", "description": "Subtier organization (SAM).", "sites": ["sam"]},
    "office":             {"type": "string", "description": "Office name (SAM).", "sites": ["sam"]},
    "category":           {"type": "string", "description": "Procurement category (CanadaBuys).", "sites": ["canada"]},
    "tender_type":        {"type": "string", "description": "Tender type (GETS).", "sites": ["gets"]},
    "type_submission":    {"type": "string", "description": "Submission type (FAT).", "sites": ["fat"]},
    "contract_nature":    {"type": "string", "description": "Nature of the contract (TED).", "sites": ["ted"]},
    "procedure_type":     {"type": "string", "description": "Procurement procedure type (TED).", "sites": ["ted"]},
    "procurement_stage":  {"type": "string", "description": "Procurement stage (Contracts Finder).", "sites": ["cfin"]},
    "procurement_category":{"type":"string","description":"Procurement category (FAT).","sites":["fat"]},
    "status":             {"type": "string", "description": "Notice status.", "sites": ["cfin"]},
    "location":           {"type": "string", "description": "Location of the contract or buyer.", "sites": ["sell2wales", "ted", "ungm", "worldbank"]},
    "place_of_performance":{"type": "string", "description": "Place of performance (TED).", "sites": ["ted"]},
    "contract_value":     {"type": "object", "description": "Contract value {amount, currency}.", "sites": ["cfin", "sell2wales"]},
    "value":              {"type": "string", "description": "Contract value as shown.", "sites": ["sell2wales"]},
    "project_title":      {"type": "string", "description": "Project title (World Bank).", "sites": ["worldbank"]},
    "description":        {"type": "string", "description": "Short description from the listing card.", "sites": ["cfin", "sam", "sell2wales", "worldbank"]},
    "publication_date":   {"type": "string", "description": "Publication date. Normalize to ISO 8601 (YYYY-MM-DD).", "sites": ["all"]},
    "published_date":     {"type": "string", "description": "Published date (FAT, SAM). Normalize to ISO 8601.", "sites": ["fat", "sam"]},
    "closing_date":       {"type": "string", "description": "Closing/deadline date. Normalize to ISO 8601.", "sites": ["all"]},
    "deadline_date":      {"type": "string", "description": "Deadline date (Public Contracts Scotland). Normalize to ISO 8601.", "sites": ["publiccontractsscotland"]},
    "close_date":         {"type": "string", "description": "Close date (GETS). Normalize to ISO 8601.", "sites": ["gets"]},
    "updated_date":       {"type": "string", "description": "Last updated date (SAM). Normalize to ISO 8601.", "sites": ["sam"]},
    "current_date_offers_due": {"type": "string", "description": "Current date offers are due (SAM). Normalize to ISO 8601.", "sites": ["sam"]},
    "published_to":       {"type": "string", "description": "Published to scope (Sell2Wales).", "sites": ["sell2wales"]},
    "language":           {"type": "string", "description": "Language of the notice.", "sites": ["worldbank"]}
  },

  "normalization_rules": {
    "publication_date":  "Normalize to ISO 8601 (YYYY-MM-DD).",
    "published_date":    "Normalize to ISO 8601 (YYYY-MM-DD).",
    "closing_date":      "Normalize to ISO 8601 (YYYY-MM-DD).",
    "deadline_date":     "Normalize to ISO 8601 (YYYY-MM-DD).",
    "close_date":        "Normalize to ISO 8601 (YYYY-MM-DD).",
    "updated_date":      "Normalize to ISO 8601 (YYYY-MM-DD).",
    "current_date_offers_due": "Normalize to ISO 8601 (YYYY-MM-DD).",
    "tender_url":        "Return the full absolute URL."
  },

  "canonical_record_key": ["tender_title", "tender_url"],
  "provenance_required": true
}
