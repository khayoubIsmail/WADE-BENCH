{
  "schema_id": "academic_event_detail_v1",
  "domain": "academic/events/conferences",
  "version": "1.0",
  "description": "Schema for extracting full academic event details from individual event pages. Each record represents one complete event.",

  "required_fields": ["event_name", "event_url"],

  "optional_fields": {
    "event_start_date":  {"type": "string", "description": "Start date. Normalize to ISO 8601 (YYYY-MM-DD).", "sites": ["all"]},
    "event_end_date":    {"type": "string", "description": "End date. Normalize to ISO 8601 (YYYY-MM-DD).", "sites": ["all"]},
    "event_start_time":  {"type": "string", "description": "Start time (HH:MM).", "sites": ["eventbrite_scitech"]},
    "event_end_time":    {"type": "string", "description": "End time (HH:MM).", "sites": ["eventbrite_scitech"]},
    "location":          {"type": "string", "description": "City, venue, country, or 'Online'.", "sites": ["all"]},
    "description":       {"type": "string", "description": "Full event description.", "sites": ["all"]},
    "event_type":        {"type": "string", "description": "Event category (e.g. 'Seminar', 'Workshop', 'Conference').", "sites": ["imperial_events", "mit_events", "stanford_events", "unesco_events"]},
    "organizer":         {"type": "string", "description": "Organizer name or organization.", "sites": ["10times", "allconferencealert", "conferencealerts", "eventbrite_scitech", "mit_events"]},
    "organized_by":      {"type": "string", "description": "Organized by (UNESCO).", "sites": ["unesco_events"]},
    "chairpersons":      {"type": "array", "description": "List of event chairpersons (CERN Indico).", "sites": ["cern_indico"]},
    "chairs":            {"type": "array", "description": "Conference chairs (GRC).", "sites": ["grc_meetings"]},
    "vice_chairs":       {"type": "array", "description": "Conference vice-chairs (GRC).", "sites": ["grc_meetings"]},
    "names_of_organizers": {"type": "array", "description": "List of organizer names (CERN Indico).", "sites": ["cern_indico"]},
    "speaker":           {"type": "string", "description": "Speaker name(s).", "sites": ["stanford_events", "unesco_events"]},
    "invited_participants": {"type": "array", "description": "List of invited participants.", "sites": ["cern_indico"]},
    "keynote_speakers":  {"type": "array", "description": "Keynote speakers list.", "sites": ["allconferencealert"]},
    "organizing_committee": {"type": "array", "description": "Organizing committee members.", "sites": ["allconferencealert"]},
    "contact":           {"type": "string", "description": "Contact information.", "sites": ["imperial_events", "mit_events", "stanford_events"]},
    "contact_person":    {"type": "string", "description": "Contact person name (Conference Alerts).", "sites": ["conferencealerts"]},
    "email":             {"type": "string", "description": "Contact email.", "sites": ["allconferencealert", "cern_indico"]},
    "website":           {"type": "string", "description": "Official event website URL.", "sites": ["allconferencealert", "conferencealerts", "mit_events", "stanford_events"]},
    "register_link":     {"type": "string", "description": "Registration link (CERN Indico, AllConferenceAlert).", "sites": ["allconferencealert", "cern_indico"]},
    "register_url":      {"type": "string", "description": "Registration URL.", "sites": ["imperial_events", "mit_events", "stanford_events", "unesco_events"]},
    "apply_link":        {"type": "string", "description": "Application link (GRC).", "sites": ["grc_meetings"]},
    "registration_url":  {"type": "string", "description": "Registration URL (Imperial, MIT).", "sites": ["imperial_events", "mit_events"]},
    "abstract_deadline": {"type": "string", "description": "Abstract/paper submission deadline. Normalize to ISO 8601.", "sites": ["allconferencealert", "conferencealerts"]},
    "registration_fee":  {"type": "string", "description": "Registration fee amount and currency.", "sites": ["allconferencealert"]},
    "cost":              {"type": "string", "description": "Admission cost or 'Free'.", "sites": ["imperial_events", "mit_events", "stanford_events"]},
    "acronym":           {"type": "string", "description": "Conference acronym.", "sites": ["conferencealerts"]},
    "edition":           {"type": ["string", "integer"], "description": "Edition number.", "sites": ["10times", "conferencealerts"]},
    "participation_type":{"type": "string", "description": "In-person, online, or hybrid.", "sites": ["conferencealerts"]},
    "subtitle":          {"type": "string", "description": "Event subtitle (GRC).", "sites": ["grc_meetings"]},
    "grc_label":         {"type": "string", "description": "GRC classification label.", "sites": ["grc_meetings"]},
    "grc_education_requirements": {"type": "string", "description": "GRC education requirements.", "sites": ["grc_meetings"]},
    "venue_and_travel_information": {"type": "string", "description": "Venue and travel details (GRC).", "sites": ["grc_meetings"]},
    "topic":             {"type": "string", "description": "Event topic or subject area.", "sites": ["10times"]},
    "rating":            {"type": "number", "description": "Event rating score.", "sites": ["10times", "allconferencealert"]},
    "rating_count":      {"type": "integer", "description": "Number of ratings.", "sites": ["10times", "allconferencealert"]},
    "exhibitors_count":  {"type": "integer", "description": "Number of exhibitors.", "sites": ["10times"]},
    "materials":         {"type": "array", "description": "Event materials/proceedings links.", "sites": ["cern_indico"]},
    "sponsors":          {"type": "array", "description": "Event sponsors list.", "sites": ["cern_indico"]},
    "hotel":             {"type": "string", "description": "Recommended hotel information.", "sites": ["cern_indico"]},
    "optional_excursions": {"type": "string", "description": "Optional excursion information.", "sites": ["cern_indico"]},
    "arrangement_type":  {"type": "string", "description": "Event arrangement type (UNESCO).", "sites": ["unesco_events"]},
    "rooms":             {"type": "array", "description": "Room/venue list (UNESCO).", "sites": ["unesco_events"]},
    "timing_start":      {"type": "string", "description": "Start time (HH:MM).", "sites": ["imperial_events"]},
    "timing_end":        {"type": "string", "description": "End time (HH:MM).", "sites": ["imperial_events"]},
    "accessibility":     {"type": "string", "description": "Accessibility information (MIT).", "sites": ["mit_events"]},
    "other_dates":       {"type": "array", "description": "Other scheduled dates for recurring events.", "sites": ["mit_events"]},
    "image_url":         {"type": "string", "description": "Event banner or photo URL.", "sites": ["10times", "grc_meetings", "imperial_events", "mit_events", "stanford_events", "unesco_events"]},
    "image_urls":        {"type": "array", "description": "Multiple event image URLs.", "sites": ["10times"]}
  },

  "normalization_rules": {
    "event_start_date":  "Normalize to ISO 8601 (YYYY-MM-DD).",
    "event_end_date":    "Normalize to ISO 8601 (YYYY-MM-DD).",
    "abstract_deadline": "Normalize to ISO 8601 (YYYY-MM-DD).",
    "event_url":         "Return the full absolute URL.",
    "register_url":      "Return the full absolute URL.",
    "register_link":     "Return the full absolute URL.",
    "apply_link":        "Return the full absolute URL.",
    "image_url":         "Return the full absolute URL."
  },

  "canonical_record_key": ["event_name", "event_url"],
  "provenance_required": true
}
