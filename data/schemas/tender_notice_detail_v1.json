{
  "schema_id": "tender_notice_detail_v1",
  "domain": "government/tenders",
  "version": "1.0",
  "description": "Schema for extracting full government tender/procurement notice details from individual notice pages. Each record represents one complete tender notice.",

  "required_fields": ["tender_title", "tender_url"],

  "optional_fields": {
    "notice_id":          {"type": "string", "description": "Notice identifier.", "sites": ["canada", "publiccontractsscotland", "sam", "sell2wales", "ted", "worldbank"]},
    "notice_type":        {"type": "string", "description": "Type of notice.", "sites": ["all"]},
    "form_type":          {"type": "string", "description": "Form type (TED).", "sites": ["ted"]},
    "status":             {"type": "string", "description": "Notice status (e.g. 'Active', 'Closed').", "sites": ["canada", "cfin", "fat", "publiccontractsscotland", "sam", "sell2wales", "worldbank"]},
    "buyer":              {"type": "object", "description": "Buyer details object (TED, Sell2Wales, WorldBank).", "sites": ["sell2wales", "ted", "worldbank"]},
    "buyer_name":         {"type": "string", "description": "Buyer organization name.", "sites": ["publiccontractsscotland", "sam", "sell2wales", "ted", "ungm"]},
    "buyer_address":      {"type": "string", "description": "Buyer postal address (TED).", "sites": ["ted"]},
    "authority_id":       {"type": "string", "description": "Authority ID (Sell2Wales).", "sites": ["sell2wales"]},
    "agency":             {"type": "string", "description": "Procuring agency (FAT).", "sites": ["fat"]},
    "awarding_agency":    {"type": "string", "description": "Awarding agency (FAT).", "sites": ["fat"]},
    "department_ind_agency": {"type": "string", "description": "Department/independent agency (SAM).", "sites": ["sam"]},
    "classification":     {"type": "string", "description": "CPV/commodity classification code(s).", "sites": ["publiccontractsscotland", "sam", "sell2wales", "ted"]},
    "description":        {"type": "string", "description": "Full notice description.", "sites": ["all"]},
    "procurement_method": {"type": "string", "description": "Procurement method.", "sites": ["canada", "fat", "worldbank"]},
    "procurement_nature": {"type": "string", "description": "Nature of procurement (FAT).", "sites": ["fat"]},
    "procurement_type":   {"type": "string", "description": "Procurement type (FAT).", "sites": ["fat"]},
    "procurement_reference": {"type": "string", "description": "Internal procurement reference.", "sites": ["cfin", "sell2wales"]},
    "procurement_documents": {"type": "string", "description": "Procurement documents info (TED).", "sites": ["ted"]},
    "procedure_type":     {"type": "string", "description": "Procurement procedure type.", "sites": ["cfin", "ted"]},
    "procedure_identifier": {"type": "string", "description": "Procedure identifier (TED).", "sites": ["ted"]},
    "legal_basis":        {"type": "string", "description": "Legal basis for the procurement (TED).", "sites": ["ted"]},
    "internal_identifier":{"type": "string", "description": "Internal document identifier (TED).", "sites": ["ted"]},
    "lot_details":        {"type": "array", "description": "Details for each lot.", "sites": ["ted", "worldbank"]},
    "lots":               {"type": "array", "description": "Lot details (World Bank).", "sites": ["worldbank"]},
    "estimated_value_excluding_vat": {"type": "object", "description": "Estimated contract value excl. VAT {amount, currency} (TED).", "sites": ["ted"]},
    "contract_value":     {"type": "object", "description": "Contract value {amount, currency}.", "sites": ["cfin"]},
    "contract_type":      {"type": "string", "description": "Contract type (Contracts Finder).", "sites": ["cfin"]},
    "contract_location":  {"type": "string", "description": "Contract location (Contracts Finder).", "sites": ["cfin"]},
    "contract_start_date":{"type": "string", "description": "Contract start date. Normalize to ISO 8601.", "sites": ["cfin"]},
    "contract_end_date":  {"type": "string", "description": "Contract end date. Normalize to ISO 8601.", "sites": ["cfin"]},
    "contract_duration":  {"type": "string", "description": "Contract duration (CanadaBuys).", "sites": ["canada"]},
    "contract_details":   {"type": "object", "description": "Contract details (Sell2Wales).", "sites": ["sell2wales"]},
    "award_criteria":     {"type": "string", "description": "Award criteria (TED).", "sites": ["ted"]},
    "selection_criteria": {"type": "string", "description": "Selection criteria (TED).", "sites": ["ted"]},
    "submission":         {"type": "object", "description": "Submission requirements (TED).", "sites": ["ted"]},
    "contract_terms":     {"type": "object", "description": "Contract terms (TED).", "sites": ["ted"]},
    "review":             {"type": "object", "description": "Review body info (TED).", "sites": ["ted"]},
    "notice_information": {"type": "object", "description": "Notice information block (TED).", "sites": ["ted"]},
    "notice_dispatch_date":{"type":"string","description":"Notice dispatch date (TED). Normalize to ISO 8601.","sites":["ted"]},
    "url_pdf_spanish_language": {"type": "string", "description": "Spanish-language PDF URL (TED).", "sites": ["ted"]},
    "publication_date":   {"type": "string", "description": "Publication date. Normalize to ISO 8601.", "sites": ["all"]},
    "published_date":     {"type": "string", "description": "Published date (FAT). Normalize to ISO 8601.", "sites": ["fat"]},
    "original_publication_date": {"type": "string", "description": "Original publication date (SAM). Normalize to ISO 8601.", "sites": ["sam"]},
    "closing_date":       {"type": "string", "description": "Closing date. Normalize to ISO 8601.", "sites": ["all"]},
    "close_date":         {"type": "string", "description": "Close date (GETS). Normalize to ISO 8601.", "sites": ["gets"]},
    "original_closing_date": {"type": "string", "description": "Original closing date (SAM). Normalize to ISO 8601.", "sites": ["sam"]},
    "closing_time":       {"type": "string", "description": "Closing time (Contracts Finder, HH:MM).", "sites": ["cfin"]},
    "inactive_date":      {"type": "string", "description": "Inactive/expiry date (SAM). Normalize to ISO 8601.", "sites": ["sam"]},
    "last_modified_date": {"type": "string", "description": "Last modified date (Sell2Wales). Normalize to ISO 8601.", "sites": ["sell2wales"]},
    "trade_agreements":   {"type": "array", "description": "Applicable trade agreements (CanadaBuys).", "sites": ["canada"]},
    "suitable_for_smes":  {"type": "boolean", "description": "Whether suitable for SMEs (Contracts Finder).", "sites": ["cfin"]},
    "suitable_for_vcses": {"type": "boolean", "description": "Whether suitable for VCSEs (Contracts Finder).", "sites": ["cfin"]},
    "industry":           {"type": "string", "description": "Industry sector (Contracts Finder).", "sites": ["cfin"]},
    "rfx_id":             {"type": "string", "description": "RFx ID (GETS).", "sites": ["gets"]},
    "reference":          {"type": "string", "description": "Reference string (GETS, UNGM).", "sites": ["gets", "ungm"]},
    "tender_type":        {"type": "string", "description": "Tender type (GETS).", "sites": ["gets"]},
    "department":         {"type": "string", "description": "Department (GETS).", "sites": ["gets"]},
    "open_date":          {"type": "string", "description": "Open date (GETS). Normalize to ISO 8601.", "sites": ["gets"]},
    "overview":           {"type": "string", "description": "Tender overview (GETS).", "sites": ["gets"]},
    "categories":         {"type": "array", "description": "Procurement categories (GETS).", "sites": ["gets"]},
    "regions":            {"type": "array", "description": "Applicable regions (GETS).", "sites": ["gets"]},
    "tender_coverage":    {"type": "string", "description": "Tender coverage scope (GETS).", "sites": ["gets"]},
    "required_pre_qualifications": {"type": "string", "description": "Required pre-qualifications (GETS).", "sites": ["gets"]},
    "alternate_physical_delivery_address": {"type": "string", "description": "Alternate physical delivery address (GETS).", "sites": ["gets"]},
    "alternate_physical_fax_number": {"type": "string", "description": "Alternate fax number (GETS).", "sites": ["gets"]},
    "quotation_no":       {"type": "string", "description": "Quotation number (FAT).", "sites": ["fat"]},
    "quotation_type":     {"type": "string", "description": "Quotation type (FAT).", "sites": ["fat"]},
    "items_to_respond":   {"type": "array", "description": "Items to respond to (FAT).", "sites": ["fat"]},
    "offer_validity_duration": {"type": "string", "description": "Offer validity duration (FAT).", "sites": ["fat"]},
    "payment_terms":      {"type": "string", "description": "Payment terms (FAT).", "sites": ["fat"]},
    "procurement_category": {"type": "string", "description": "Procurement category (FAT).", "sites": ["fat"]},
    "remarks":            {"type": "string", "description": "Additional remarks (FAT).", "sites": ["fat"]},
    "contact_persons_details": {"type": "object", "description": "Contact persons (FAT).", "sites": ["fat"]},
    "contact_name":       {"type": "string", "description": "Contact person name (Contracts Finder).", "sites": ["cfin"]},
    "contact":            {"type": "object", "description": "Contact information object (GETS).", "sites": ["gets"]},
    "contact_information":{"type": "object", "description": "Full contact details.", "sites": ["publiccontractsscotland", "sam", "sell2wales", "ungm", "worldbank"]},
    "address":            {"type": "string", "description": "Buyer address (Contracts Finder).", "sites": ["cfin"]},
    "email":              {"type": "string", "description": "Contact email (Contracts Finder).", "sites": ["cfin"]},
    "telephone":          {"type": "string", "description": "Contact telephone (Contracts Finder).", "sites": ["cfin"]},
    "website":            {"type": "string", "description": "Buyer website (Contracts Finder).", "sites": ["cfin"]},
    "language":           {"type": "string", "description": "Language of the notice.", "sites": ["canada", "worldbank"]},
    "apply_portal_link":  {"type": "string", "description": "Application portal link (CanadaBuys).", "sites": ["canada"]},
    "attachments":        {"type": "array", "description": "Attached documents (SAM).", "sites": ["sam"]},
    "registration_level": {"type": "string", "description": "Vendor registration level required (UNGM).", "sites": ["ungm"]},
    "beneficiary_countries_or_territories": {"type": "array", "description": "Beneficiary countries/territories (UNGM).", "sites": ["ungm"]},
    "unspsc_codes":       {"type": "array", "description": "UNSPSC commodity codes (UNGM).", "sites": ["ungm"]},
    "revisions":          {"type": "array", "description": "Notice revision history (UNGM).", "sites": ["ungm"]},
    "links":              {"type": "array", "description": "Related links (UNGM).", "sites": ["ungm"]},
    "ocid":               {"type": "string", "description": "Open Contracting ID.", "sites": ["sell2wales"]},
    "engagement":         {"type": "object", "description": "Engagement/market consultation info (Sell2Wales).", "sites": ["sell2wales"]},
    "documents":          {"type": "array", "description": "Tender documents list (Sell2Wales).", "sites": ["sell2wales"]},
    "project_title":      {"type": "string", "description": "Project title (World Bank).", "sites": ["worldbank"]},
    "project_id":         {"type": "string", "description": "Project ID (World Bank).", "sites": ["worldbank"]},
    "project_financing":  {"type": "string", "description": "Financing instrument (World Bank).", "sites": ["worldbank"]},
    "country":            {"type": "string", "description": "Country (World Bank).", "sites": ["worldbank"]},
    "borrower_bid_reference": {"type": "string", "description": "Borrower's bid reference (World Bank).", "sites": ["worldbank"]},
    "reference_no_in_notice_text": {"type": "string", "description": "Reference number in notice text (World Bank).", "sites": ["worldbank"]},
    "bidding_details":    {"type": "object", "description": "Bidding details (World Bank).", "sites": ["worldbank"]},
    "bid_security":       {"type": "string", "description": "Bid security requirement (World Bank).", "sites": ["worldbank"]},
    "notice_information": {"type": "object", "description": "Notice information block.", "sites": ["ted"]}
  },

  "normalization_rules": {
    "publication_date":   "Normalize to ISO 8601 (YYYY-MM-DD).",
    "published_date":     "Normalize to ISO 8601 (YYYY-MM-DD).",
    "closing_date":       "Normalize to ISO 8601 (YYYY-MM-DD).",
    "close_date":         "Normalize to ISO 8601 (YYYY-MM-DD).",
    "original_closing_date": "Normalize to ISO 8601 (YYYY-MM-DD).",
    "original_publication_date": "Normalize to ISO 8601 (YYYY-MM-DD).",
    "contract_start_date":"Normalize to ISO 8601 (YYYY-MM-DD).",
    "contract_end_date":  "Normalize to ISO 8601 (YYYY-MM-DD).",
    "inactive_date":      "Normalize to ISO 8601 (YYYY-MM-DD).",
    "last_modified_date": "Normalize to ISO 8601 (YYYY-MM-DD).",
    "notice_dispatch_date": "Normalize to ISO 8601 (YYYY-MM-DD).",
    "tender_url":         "Return the full absolute URL.",
    "apply_portal_link":  "Return the full absolute URL."
  },

  "canonical_record_key": ["tender_title", "tender_url"],
  "provenance_required": true
}
